\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}What changed from the course template}{8}{subsection.3.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}Component deep dives}{8}{section.4}\protected@file@percent }
