\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Clock tree (rPLL plus per peripheral prescalers)}{9}{subsection.4.2}\protected@file@percent }
\newlabel{sec:clocks}{{4.2}{9}{Clock tree (rPLL plus per peripheral prescalers)}{subsection.4.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Clock tree. The rPLL takes the 27 MHz crystal and produces two synchronous clocks at 40.5 MHz (bus) and 100 MHz (SDRAM, with phase shift). Each peripheral that needs a slower clock instantiates its own integer divider downstream of the bus clock. We did not use Gowin clock gating primitives for any of these, simply because the divider counters are trivial in resources and give us per peripheral control of the prescaler ratio at synthesis time.}}{10}{figure.caption.6}\protected@file@percent }
\newlabel{fig:clocktree}{{4}{10}{Clock tree. The rPLL takes the 27 MHz crystal and produces two synchronous clocks at 40.5 MHz (bus) and 100 MHz (SDRAM, with phase shift). Each peripheral that needs a slower clock instantiates its own integer divider downstream of the bus clock. We did not use Gowin clock gating primitives for any of these, simply because the divider counters are trivial in resources and give us per peripheral control of the prescaler ratio at synthesis time}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}SDRAM controller}{10}{subsection.4.3}\protected@file@percent }
\newlabel{sec:sdram}{{4.3}{10}{SDRAM controller}{subsection.4.3}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.3.1}Init sequence}{10}{subsubsection.4.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces SDRAM read cycle, simplified. ACTIVATE opens the row, READ selects the column, the chip drives the data line three clocks later (CAS latency 3). PRECHARGE closes the row.}}{11}{figure.caption.7}\protected@file@percent }
\newlabel{fig:sdram-timing}{{5}{11}{SDRAM read cycle, simplified. ACTIVATE opens the row, READ selects the column, the chip drives the data line three clocks later (CAS latency 3). PRECHARGE closes the row}{figure.caption.7}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.3.2}Problems we had}{11}{subsubsection.4.3.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Hardware accelerator pipeline}{11}{subsection.4.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Streaming pipeline from microphone to decoded symbol. Each stage is autonomous: the SPI receiver pushes samples into BSRAM as they arrive, the FFT engine pulls 256 sample windows out and produces magnitude bins which are stored in SDRAM, the audio decoder watches the bins for tones matching our codebook and emits a character on the UART when it sees one.}}{11}{figure.caption.8}\protected@file@percent }
\newlabel{fig:audio-pipeline}{{6}{11}{Streaming pipeline from microphone to decoded symbol. Each stage is autonomous: the SPI receiver pushes samples into BSRAM as they arrive, the FFT engine pulls 256 sample windows out and produces magnitude bins which are stored in SDRAM, the audio decoder watches the bins for tones matching our codebook and emits a character on the UART when it sees one}{figure.caption.8}{}}
