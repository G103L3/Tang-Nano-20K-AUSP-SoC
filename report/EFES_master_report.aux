\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Clock tree. The 27\,MHz input is the PLL reference and also clocks the PWM, GPIO and boot banner directly. The rPLL produces 40.5\,MHz (\texttt  {clkout}) for the CPU, bus and most peripherals, and a $+1.54$\,ns phase shifted copy (\texttt  {clkoutp}) that clocks only the SDRAM die.}}{8}{figure.caption.8}\protected@file@percent }
\newlabel{fig:clocktree}{{4}{8}{Clock tree. The 27\,MHz input is the PLL reference and also clocks the PWM, GPIO and boot banner directly. The rPLL produces 40.5\,MHz (\texttt {clkout}) for the CPU, bus and most peripherals, and a $+1.54$\,ns phase shifted copy (\texttt {clkoutp}) that clocks only the SDRAM die}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}SDRAM controller}{8}{section.5}\protected@file@percent }
\newlabel{sec:sdram}{{5}{8}{SDRAM controller}{section.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Bring up sequence}{8}{subsection.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces SDRAM single word read at 40.5\,MHz (one clock $=24.7$\,ns). ACTIVATE at T0 opens the row, $t_\mathrm  {RCD}$ later the READ at T3 selects the column, and with CAS latency 3 the word is valid on DQ at T6 ($3\times 24.7=74$\,ns after the READ). PRECHARGE at T8 closes the row, after which $t_\mathrm  {RP}$ must elapse before the next ACTIVATE. With burst length 1, exactly one word comes out per READ.}}{9}{figure.caption.9}\protected@file@percent }
\newlabel{fig:sdram-timing}{{5}{9}{SDRAM single word read at 40.5\,MHz (one clock $=24.7$\,ns). ACTIVATE at T0 opens the row, $t_\mathrm {RCD}$ later the READ at T3 selects the column, and with CAS latency 3 the word is valid on DQ at T6 ($3\times 24.7=74$\,ns after the READ). PRECHARGE at T8 closes the row, after which $t_\mathrm {RP}$ must elapse before the next ACTIVATE. With burst length 1, exactly one word comes out per READ}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {section}{\numberline {6}Audio accelerator and tone decoder}{9}{section.6}\protected@file@percent }
\newlabel{sec:accel}{{6}{9}{Audio accelerator and tone decoder}{section.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Receive pipeline (black and white). The capture FSM fills one half of the ping-pong block RAM while the FFT FSM processes the other half into a spectrum in SDRAM; the soft core then reads the spectrum back over the bus (S0) and, in firmware, decodes one character per tone and sends it to the ESP32.}}{10}{figure.caption.10}\protected@file@percent }
\newlabel{fig:audio-pipeline}{{6}{10}{Receive pipeline (black and white). The capture FSM fills one half of the ping-pong block RAM while the FFT FSM processes the other half into a spectrum in SDRAM; the soft core then reads the spectrum back over the bus (S0) and, in firmware, decodes one character per tone and sends it to the ESP32}{figure.caption.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}Timing in cycles and in seconds}{10}{subsection.6.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}The two state machines}{11}{subsection.6.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces The two parallel FSMs. Capture reads one ADC sample per pass (\texttt  {DS\_OPEN} starts the SPI, \texttt  {DS\_POLL} waits for the conversion, \texttt  {DS\_READ}/\texttt  {DS\_STORE} write it into the ping-pong buffer) and pulses \texttt  {fft\_trigger} every 512 samples. The FFT FSM, on that trigger, feeds the window (\texttt  {FS\_FEED}), runs the FFT (\texttt  {FS\_COMPUTE}), collects the bins (\texttt  {FS\_COLLECT}), writes them to SDRAM (\texttt  {FS\_DRAIN}) and raises the IRQ (\texttt  {FS\_IRQ}). Inside the accelerator the capture path has priority on the M1 bus port, so if both want the bus during \texttt  {FS\_DRAIN} the FFT simply stalls (it gets no ack) and resumes when capture releases.}}{11}{figure.caption.11}\protected@file@percent }
\newlabel{fig:accel-fsm}{{7}{11}{The two parallel FSMs. Capture reads one ADC sample per pass (\texttt {DS\_OPEN} starts the SPI, \texttt {DS\_POLL} waits for the conversion, \texttt {DS\_READ}/\texttt {DS\_STORE} write it into the ping-pong buffer) and pulses \texttt {fft\_trigger} every 512 samples. The FFT FSM, on that trigger, feeds the window (\texttt {FS\_FEED}), runs the FFT (\texttt {FS\_COMPUTE}), collects the bins (\texttt {FS\_COLLECT}), writes them to SDRAM (\texttt {FS\_DRAIN}) and raises the IRQ (\texttt {FS\_IRQ}). Inside the accelerator the capture path has priority on the M1 bus port, so if both want the bus during \texttt {FS\_DRAIN} the FFT simply stalls (it gets no ack) and resumes when capture releases}{figure.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Audio accelerator control registers, base \texttt  {0x3000\_0000}.}}{11}{table.caption.12}\protected@file@percent }
