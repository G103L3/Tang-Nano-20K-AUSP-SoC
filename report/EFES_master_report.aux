\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces PWM register map (speaker base \texttt  {0x5000\_0000}, LED base \texttt  {0x6000\_0000}). \texttt  {F\_WIDTH} is the period field width.}}{19}{table.caption.21}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Attack/release envelope FSM in the PWM block. \texttt  {start} is set by the \texttt  {0x04} write and cleared by \texttt  {0x08}. Attack ramps the amplitude up, \texttt  {E\_ON} holds it, release ramps it down; a stop during attack or a start during release switches directly between the two ramps, so a retriggered tone never clicks.}}{19}{figure.caption.22}\protected@file@percent }
\newlabel{fig:pwm-env}{{12}{19}{Attack/release envelope FSM in the PWM block. \texttt {start} is set by the \texttt {0x04} write and cleared by \texttt {0x08}. Attack ramps the amplitude up, \texttt {E\_ON} holds it, release ramps it down; a stop during attack or a start during release switches directly between the two ramps, so a retriggered tone never clicks}{figure.caption.22}{}}
