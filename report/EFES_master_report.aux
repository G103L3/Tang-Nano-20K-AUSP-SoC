\@writefile{toc}{\contentsline {section}{\numberline {7}SPI master for the ADC, and the microphone front end}{17}{section.7}\protected@file@percent }
\newlabel{sec:adc}{{7}{17}{SPI master for the ADC, and the microphone front end}{section.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces SPI master (ADC) register map, base \texttt  {0x4000\_0000} (offset in the low bits).}}{18}{table.caption.18}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.1}Why a custom SPI master and not a generic one}{18}{subsection.7.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces MCP3201 read as seen by the SPI master. CS goes low, the master issues 16 SCK periods at 750\,kHz, discards the leading null bit, captures the 12 data bits B11 down to B0 most significant first, then raises CS to end the frame. One frame is $16 / 750\,\mathrm  {kHz} = 21.3\,\mu s$, which sets the 46.9\,kHz sample rate.}}{18}{figure.caption.19}\protected@file@percent }
\newlabel{fig:spi-timing}{{10}{18}{MCP3201 read as seen by the SPI master. CS goes low, the master issues 16 SCK periods at 750\,kHz, discards the leading null bit, captures the 12 data bits B11 down to B0 most significant first, then raises CS to end the frame. One frame is $16 / 750\,\mathrm {kHz} = 21.3\,\mu s$, which sets the 46.9\,kHz sample rate}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces SPI master (ADC) frame FSM, from \texttt  {spi\_master.vhd}. A write to \texttt  {0x04} asserts CS low and starts one MCP3201 frame of 16 SCK periods at 750\,kHz (\texttt  {PRESCALER}=54 from the 40.5\,MHz clock). \texttt  {S\_LEAD} clocks the leading null bit, \texttt  {S\_CAPTURE} shifts MISO in most significant first for the 12 data bits, \texttt  {S\_LATCH} writes them into the \texttt  {0x00} register and sets \texttt  {data\_ready}, \texttt  {S\_TAIL} raises CS to close the 21.3\,$\mu $s frame. While \texttt  {0x04} (start) stays asserted the frame re-arms, which gives the continuous 46.9\,kHz sample stream the FFT needs; a write to \texttt  {0x0C} clears \texttt  {data\_ready}.}}{18}{figure.caption.20}\protected@file@percent }
\newlabel{fig:spi-fsm}{{11}{18}{SPI master (ADC) frame FSM, from \texttt {spi\_master.vhd}. A write to \texttt {0x04} asserts CS low and starts one MCP3201 frame of 16 SCK periods at 750\,kHz (\texttt {PRESCALER}=54 from the 40.5\,MHz clock). \texttt {S\_LEAD} clocks the leading null bit, \texttt {S\_CAPTURE} shifts MISO in most significant first for the 12 data bits, \texttt {S\_LATCH} writes them into the \texttt {0x00} register and sets \texttt {data\_ready}, \texttt {S\_TAIL} raises CS to close the 21.3\,$\mu $s frame. While \texttt {0x04} (start) stays asserted the frame re-arms, which gives the continuous 46.9\,kHz sample stream the FFT needs; a write to \texttt {0x0C} clears \texttt {data\_ready}}{figure.caption.20}{}}
