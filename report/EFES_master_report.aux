\@writefile{toc}{\contentsline {section}{\numberline {7}SPI master for the ADC, and the microphone front end}{12}{section.7}\protected@file@percent }
\newlabel{sec:adc}{{7}{12}{SPI master for the ADC, and the microphone front end}{section.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces SPI master (ADC) register map, base \texttt  {0x4000\_0000} (offset in the low bits).}}{12}{table.caption.14}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.1}Why a custom SPI master and not a generic one}{12}{subsection.7.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces MCP3201 read as seen by the SPI master. CS goes low, the master issues 16 SCK periods at 750\,kHz, discards the leading null bit, captures the 12 data bits B11 down to B0 most significant first, then raises CS to end the frame. One frame is $16 / 750\,\mathrm  {kHz} = 21.3\,\mu s$, which sets the 46.9\,kHz sample rate.}}{13}{figure.caption.15}\protected@file@percent }
\newlabel{fig:spi-timing}{{8}{13}{MCP3201 read as seen by the SPI master. CS goes low, the master issues 16 SCK periods at 750\,kHz, discards the leading null bit, captures the 12 data bits B11 down to B0 most significant first, then raises CS to end the frame. One frame is $16 / 750\,\mathrm {kHz} = 21.3\,\mu s$, which sets the 46.9\,kHz sample rate}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces SPI master (ADC) frame FSM, from \texttt  {spi\_master.vhd}. A write to \texttt  {0x04} asserts CS low and starts one MCP3201 frame of 16 SCK periods at 750\,kHz (\texttt  {PRESCALER}=54 from the 40.5\,MHz clock). \texttt  {S\_LEAD} clocks the leading null bit, \texttt  {S\_CAPTURE} shifts MISO in most significant first for the 12 data bits, \texttt  {S\_LATCH} writes them into the \texttt  {0x00} register and sets \texttt  {data\_ready}, \texttt  {S\_TAIL} raises CS to close the 21.3\,$\mu $s frame. While \texttt  {0x04} (start) stays asserted the frame re-arms, which gives the continuous 46.9\,kHz sample stream the FFT needs; a write to \texttt  {0x0C} clears \texttt  {data\_ready}.}}{13}{figure.caption.16}\protected@file@percent }
\newlabel{fig:spi-fsm}{{9}{13}{SPI master (ADC) frame FSM, from \texttt {spi\_master.vhd}. A write to \texttt {0x04} asserts CS low and starts one MCP3201 frame of 16 SCK periods at 750\,kHz (\texttt {PRESCALER}=54 from the 40.5\,MHz clock). \texttt {S\_LEAD} clocks the leading null bit, \texttt {S\_CAPTURE} shifts MISO in most significant first for the 12 data bits, \texttt {S\_LATCH} writes them into the \texttt {0x00} register and sets \texttt {data\_ready}, \texttt {S\_TAIL} raises CS to close the 21.3\,$\mu $s frame. While \texttt {0x04} (start) stays asserted the frame re-arms, which gives the continuous 46.9\,kHz sample stream the FFT needs; a write to \texttt {0x0C} clears \texttt {data\_ready}}{figure.caption.16}{}}
\@writefile{toc}{\contentsline {section}{\numberline {8}PWM speaker and LED}{13}{section.8}\protected@file@percent }
\newlabel{sec:speaker}{{8}{13}{PWM speaker and LED}{section.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces PWM register map (speaker base \texttt  {0x5000\_0000}, LED base \texttt  {0x6000\_0000}). \texttt  {F\_WIDTH} is the period field width.}}{13}{table.caption.17}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Attack/release envelope FSM in the PWM block. \texttt  {start} is set by the \texttt  {0x04} write and cleared by \texttt  {0x08}. Attack ramps the amplitude up, \texttt  {E\_ON} holds it, release ramps it down; a stop during attack or a start during release switches directly between the two ramps, so a retriggered tone never clicks.}}{14}{figure.caption.18}\protected@file@percent }
\newlabel{fig:pwm-env}{{10}{14}{Attack/release envelope FSM in the PWM block. \texttt {start} is set by the \texttt {0x04} write and cleared by \texttt {0x08}. Attack ramps the amplitude up, \texttt {E\_ON} holds it, release ramps it down; a stop during attack or a start during release switches directly between the two ramps, so a retriggered tone never clicks}{figure.caption.18}{}}
\@writefile{toc}{\contentsline {section}{\numberline {9}NOR flash controller}{14}{section.9}\protected@file@percent }
\newlabel{sec:flashctrl}{{9}{14}{NOR flash controller}{section.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {9.1}Memory layout}{14}{subsection.9.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Flash memory map (low 12\,KB). Three 4\,KB sectors: sector 0 holds the 32 byte settings, sectors 1 and 2 hold the 512 slot log ring buffer. Below, the 16 byte record and the settings sector are cut into their byte fields.}}{15}{figure.caption.19}\protected@file@percent }
\newlabel{fig:flash-map}{{11}{15}{Flash memory map (low 12\,KB). Three 4\,KB sectors: sector 0 holds the 32 byte settings, sectors 1 and 2 hold the 512 slot log ring buffer. Below, the 16 byte record and the settings sector are cut into their byte fields}{figure.caption.19}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {9.2}State machine}{15}{subsection.9.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces flash\_ctrl state machine. At power up it unlocks the chip (WRSR clears the protection bits BP0..BP2 and SRP and sets QE, then a Global Block Unlock), reads the status register back to confirm, and scans all 512 slots to find the head of the ring buffer, then sits in IDLE. Each UART opcode (\texttt  {L} append, \texttt  {S} save settings, \texttt  {C} clear, \texttt  {G} read, \texttt  {H} read head) is entered from IDLE on its character and returns to IDLE when its SPI sequence finishes; the double headed arrows mean exactly that go and return.}}{15}{figure.caption.20}\protected@file@percent }
\newlabel{fig:flashctrl-fsm}{{12}{15}{flash\_ctrl state machine. At power up it unlocks the chip (WRSR clears the protection bits BP0..BP2 and SRP and sets QE, then a Global Block Unlock), reads the status register back to confirm, and scans all 512 slots to find the head of the ring buffer, then sits in IDLE. Each UART opcode (\texttt {L} append, \texttt {S} save settings, \texttt {C} clear, \texttt {G} read, \texttt {H} read head) is entered from IDLE on its character and returns to IDLE when its SPI sequence finishes; the double headed arrows mean exactly that go and return}{figure.caption.20}{}}
\@writefile{toc}{\contentsline {paragraph}{Append (opcode L) as an SPI sequence.}{15}{section*.21}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Append (opcode \texttt  {L}) as the time ordered sequence of SPI frames the controller sends to the W25Q. Each solid box is one CS low frame; the dashed boxes are status polls (read \texttt  {0x05}, loop while the WIP write in progress bit is 1). The controller first probes the target slot; the erase happens only if that slot is not \texttt  {0xFF}, because a NOR program can only turn 1 bits into 0, so writing over a used slot would corrupt it. A read (opcode \texttt  {G}) is instead a single frame: \texttt  {0x03} + 24 bit address, then clock out $N\times 16$ data bytes.}}{16}{figure.caption.22}\protected@file@percent }
\newlabel{fig:flash-append}{{13}{16}{Append (opcode \texttt {L}) as the time ordered sequence of SPI frames the controller sends to the W25Q. Each solid box is one CS low frame; the dashed boxes are status polls (read \texttt {0x05}, loop while the WIP write in progress bit is 1). The controller first probes the target slot; the erase happens only if that slot is not \texttt {0xFF}, because a NOR program can only turn 1 bits into 0, so writing over a used slot would corrupt it. A read (opcode \texttt {G}) is instead a single frame: \texttt {0x03} + 24 bit address, then clock out $N\times 16$ data bytes}{figure.caption.22}{}}
