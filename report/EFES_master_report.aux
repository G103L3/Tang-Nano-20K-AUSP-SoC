\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces The alternating bit codebook. A pattern (its first bit and length) plus the carrier it rides on selects one message; the same pattern means different things on the two carriers, because the carrier says who is speaking. On the master carrier the data bits are the tones \texttt  {a}/\texttt  {b}, on the slave carrier \texttt  {A}/\texttt  {B}.}}{29}{table.caption.32}\protected@file@percent }
\newlabel{tab:codebook}{{13}{29}{The alternating bit codebook. A pattern (its first bit and length) plus the carrier it rides on selects one message; the same pattern means different things on the two carriers, because the carrier says who is speaking. On the master carrier the data bits are the tones \texttt {a}/\texttt {b}, on the slave carrier \texttt {A}/\texttt {B}}{table.caption.32}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {14.1}On the air: warm up, redundancy, and detection by change}{29}{subsection.14.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces One transmission on the air (here the presence request, pattern \texttt  {01}). Every box is a two tone burst (carrier $+$ data tone); the darker, longer first box is the warm up EOF that settles the receiver's AGC. The receiver collapses each EOF burst into one EOF event by detection by change, so what reaches the protocol layer is exactly \texttt  {c\,0\,1\,c}.}}{30}{figure.caption.33}\protected@file@percent }
\newlabel{fig:tx-timeline}{{18}{30}{One transmission on the air (here the presence request, pattern \texttt {01}). Every box is a two tone burst (carrier $+$ data tone); the darker, longer first box is the warm up EOF that settles the receiver's AGC. The receiver collapses each EOF burst into one EOF event by detection by change, so what reaches the protocol layer is exactly \texttt {c\,0\,1\,c}}{figure.caption.33}{}}
