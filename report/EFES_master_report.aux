\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Block diagram}{5}{subsection.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces SoC top level (black and white). Each block reaches the central 32 bit Wishbone bus with three thick arrows: \emph  {data} is bidirectional, while \emph  {control} and \emph  {address} arrows point toward the bus for the two masters (PicoRV32, audio accelerator) and toward the block for the slaves, indicating signal direction. The audio accelerator is both a master (M1, to move samples) and a slave (S5, for its control registers). ITCM and DTCM are CPU local block RAM, not on the Wishbone. The character UART generic slave S6 (\texttt  {0x2}) reaches the ESP32 on pins 17 and 18 and carries the protocol characters (boot banner, decoder output, soft core). The \textbf  {NOR flash controller} (\texttt  {flash\_ctrl}) is a self contained hardware block, \emph  {not} on the Wishbone bus and with no CPU in the loop: its UART side talks to the ESP32 on pins 72 and 20 (storage commands), and its SPI side drives the W25Q chip on pins 42, 41, 51, 48. The two \texttt  {flash\_ctrl} boxes in the figure (UART side, top right; SPI side, lower left) are the \emph  {same} block, drawn at its two pin groups; neither has bus arrows, because it does not touch the bus. Every external connection carries its real FPGA pin number from the constraints file.}}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig:soc}{{2}{5}{SoC top level (black and white). Each block reaches the central 32 bit Wishbone bus with three thick arrows: \emph {data} is bidirectional, while \emph {control} and \emph {address} arrows point toward the bus for the two masters (PicoRV32, audio accelerator) and toward the block for the slaves, indicating signal direction. The audio accelerator is both a master (M1, to move samples) and a slave (S5, for its control registers). ITCM and DTCM are CPU local block RAM, not on the Wishbone. The character UART generic slave S6 (\texttt {0x2}) reaches the ESP32 on pins 17 and 18 and carries the protocol characters (boot banner, decoder output, soft core). The \textbf {NOR flash controller} (\texttt {flash\_ctrl}) is a self contained hardware block, \emph {not} on the Wishbone bus and with no CPU in the loop: its UART side talks to the ESP32 on pins 72 and 20 (storage commands), and its SPI side drives the W25Q chip on pins 42, 41, 51, 48. The two \texttt {flash\_ctrl} boxes in the figure (UART side, top right; SPI side, lower left) are the \emph {same} block, drawn at its two pin groups; neither has bus arrows, because it does not touch the bus. Every external connection carries its real FPGA pin number from the constraints file}{figure.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}The on chip bus and the address map}{5}{subsection.3.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Address map, decoded from \texttt  {addr[31:27]} (five bits). The NOR flash is \emph  {not} on this bus: it is an independent hardware block (\texttt  {flash\_ctrl}), so the CPU map has seven slaves. SDRAM sits at \texttt  {0x4800\_0000}, not in the \texttt  {0x0}--\texttt  {0x1} range, because that range is the soft core's own internal space (see text).}}{6}{table.caption.4}\protected@file@percent }
\newlabel{tab:addrmap}{{1}{6}{Address map, decoded from \texttt {addr[31:27]} (five bits). The NOR flash is \emph {not} on this bus: it is an independent hardware block (\texttt {flash\_ctrl}), so the CPU map has seven slaves. SDRAM sits at \texttt {0x4800\_0000}, not in the \texttt {0x0}--\texttt {0x1} range, because that range is the soft core's own internal space (see text)}{table.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The 32 bit address is split in two. The top five bits \texttt  {addr[31:27]} pick the slave (Table~\ref {tab:addrmap}); the low 27 bits are the offset inside that slave, of which each peripheral decodes only the few it needs (the per device register maps below).}}{6}{figure.caption.5}\protected@file@percent }
\newlabel{fig:addrfield}{{3}{6}{The 32 bit address is split in two. The top five bits \texttt {addr[31:27]} pick the slave (Table~\ref {tab:addrmap}); the low 27 bits are the offset inside that slave, of which each peripheral decodes only the few it needs (the per device register maps below)}{figure.caption.5}{}}
